#!/bin/bash
# Runs one Playwright MCP server over HTTP (launchd: carhunt.lanes / carhunt.identity / carhunt.identity-<x>).
#
#   serve lanes          --isolated: every MCP connection gets its own throwaway context in one shared Chrome.
#                        No logins; freed when the client disconnects.
#   serve identity       the persistent master profile (the owner's logins). One holder at a time: a second
#                        client gets "Browser is already in use"; `pw-identity` hooks manage hold/release.
#   serve identity-<x>   pool copy <x> of the master (made by `pw-identity seed`), one holder each.
#
# Ports, profile and output dirs come from `python -m carhunt.access.mcp ports <mode>` (config `browsers`;
# env CARHUNT_MCP_PORT / CARHUNT_MCP_DEBUG_PORT / CARHUNT_MCP_PROFILE / CARHUNT_MCP_OUT override).
# Each Chrome also listens on a localhost debug port so the captcha solver can attach to an agent's tab.
# Headless Agent Chrome presenting headed Chrome's UA + client hints (real-chrome-ua.cjs); CARHUNT_PW_VISIBLE=1
# gives a normal window. Never /Applications/Google Chrome.app: macOS takes the agent for the user's Chrome (10-16).
#
# Env: CARHUNT_NODE (else `node` on PATH), CARHUNT_CHROME (skip agent-chrome, e.g. Linux or tests).
set -u
self="$0"
while [ -L "$self" ]; do l="$(readlink "$self")"; case "$l" in /*) self="$l" ;; *) self="$(dirname "$self")/$l" ;; esac; done
HERE="$(cd -P "$(dirname "$self")" && pwd)"
# shellcheck source=SCRIPTDIR/_lib.sh
. "$HERE/_lib.sh"

mode="${1:-}"
case "$mode" in
  lanes | identity | identity-[a-h]) ;;
  *) echo "usage: $0 lanes|identity|identity-<a..h>" >&2; exit 2 ;;
esac

NODE="${CARHUNT_NODE:-$(command -v node || true)}"
[ -n "$NODE" ] && [ -x "$NODE" ] || { echo "serve: no node (install Node ≥18 or set CARHUNT_NODE)" >&2; exit 1; }
CLI="$CARHUNT_REPO/browsers/node_modules/@playwright/mcp/cli.js"
[ -f "$CLI" ] || { echo "serve: $CLI missing (run: npm ci --prefix $CARHUNT_REPO/browsers)" >&2; exit 1; }

# MCP_PORT DEBUG_PORT PROFILE OUT_DIR CONFIG ISOLATED HEADLESS (shell-quoted by the helper)
vars="$("$(carhunt_python)" -m carhunt.access.mcp ports "$mode")" || exit 1
MCP_PORT='' PROFILE='' OUT_DIR='' CONFIG='' ISOLATED=0 HEADLESS=1
eval "$vars"

CHROME="${CARHUNT_CHROME:-}"
[ -n "$CHROME" ] || CHROME="$("$HERE/agent-chrome")" || exit 1

# Default host = localhost; clients must use http://localhost:<port>/mcp (the server's DNS-rebinding guard
# rejects any other Host header, e.g. 127.0.0.1).
args=(--port "$MCP_PORT" --browser chrome --executable-path "$CHROME"
      --config "$CONFIG" --output-dir "$OUT_DIR"
      --caps vision)   # coordinate mouse tools (browser_mouse_click_xy …) for captchas and canvas UIs
if [ "$ISOLATED" = 1 ]; then
  args+=(--isolated)
else
  args+=(--user-data-dir "$PROFILE")
fi
if [ "$HEADLESS" = 1 ] && [ "${CARHUNT_PW_VISIBLE:-}" != 1 ]; then
  args+=(--headless --init-page "$CARHUNT_REPO/browsers/real-chrome-ua.cjs")
fi

exec "$NODE" "$CLI" "${args[@]}"
