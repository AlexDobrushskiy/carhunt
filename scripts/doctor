#!/bin/sh
# carhunt doctor: ok / warn / fail per component, exit 1 on any fail.
REPO=$(cd "$(dirname "$0")/.." && pwd)
if [ -x "$REPO/.venv/bin/carhunt" ]; then exec "$REPO/.venv/bin/carhunt" doctor "$@"; fi
if command -v carhunt >/dev/null 2>&1; then exec carhunt doctor "$@"; fi
echo "carhunt is not installed: run scripts/bootstrap" >&2
exit 1
