---
// Key-option icons (the profile's must-haves + top wanted options): ✓ yes / struck no / ? unknown. Hover = title, tap = info line.
import { iconOptions } from "@/lib/vocab";
import { iconKeys } from "@/lib/profile";
interface Props { values: Record<string, string | undefined | null>; sources?: Record<string, string | undefined | null>; class?: string }
const { values, sources, class: cls = "" } = Astro.props;
const { profile } = Astro.locals;
const items = iconOptions(iconKeys(profile), values, sources, profile.ownerName);
const ICON: Record<string, string> = {
  electric_seats: '<path d="M6.5 3h3l1.6 9h6.4a1.5 1.5 0 0 1 1.5 1.5V16H8.6a1.5 1.5 0 0 1-1.5-1.3z"/><path d="M9.5 16v4.5M17 16v4.5"/>',
  power_tailgate: '<path d="M14 9H6.5L3 12.5V17h16v-4.5h-3"/><path d="M14 9l7-2.5"/><circle cx="7" cy="17" r="1.7"/><circle cx="15" cy="17" r="1.7"/>',
  pano: '<rect x="6.5" y="2" width="11" height="20" rx="4"/><rect x="8.5" y="7.5" width="7" height="9" rx="1" fill="currentColor" fill-opacity="0.25"/><path d="M10 14l3.5-4.5"/>',
  premium_audio: '<rect x="6" y="2.5" width="12" height="19" rx="2"/><circle cx="12" cy="14.5" r="3.7"/><circle cx="12" cy="7.3" r="1.3"/>',
  heat_pump: '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><circle cx="12" cy="12" r="2.5"/>',
  towbar: '<path d="M3 9h10v4h4"/><circle cx="19" cy="13" r="2"/>',
  camera_360: '<path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.2"/>',
  heated_seats: '<path d="M6.5 3h3l1.6 9h6.4a1.5 1.5 0 0 1 1.5 1.5V16H8.6a1.5 1.5 0 0 1-1.5-1.3z"/><path d="M14 3c-1 1.3 1 2.2 0 3.5M17.5 3c-1 1.3 1 2.2 0 3.5"/>',
  hud: '<path d="M3 17h18M7 17l2-9h6l2 9"/><path d="M10 11h4"/>',
  adaptive_cruise: '<circle cx="12" cy="13" r="8"/><path d="M12 13l4-4M8 17h8"/>',
};
// Any other option key: its two initials in a rounded square.
const initials = (label: string) => label.split(/[\s_/-]+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join("");
const fallback = (label: string) => `<rect x="3" y="3" width="18" height="18" rx="4"/><text x="12" y="16" text-anchor="middle" font-size="9" font-family="system-ui,sans-serif" stroke="none" fill="currentColor">${initials(label)}</text>`;
const TONE = { yes: "text-fg", no: "text-muted opacity-60", unknown: "text-muted opacity-70" };
const BADGE = { yes: "bg-good text-surface", no: "bg-surface-2 text-muted border border-line", unknown: "bg-surface-2 text-muted border border-line" };
const SYM = { yes: "✓", no: "✗", unknown: "?" };
---
<div class={`kopts flex flex-col gap-1 ${cls}`} data-testid="option-icons">
  <div class="flex items-center gap-1">
    {items.map((o) => (
      <button type="button" data-kopt={o.key} data-state={o.state} data-info={o.info} title={o.info} aria-label={o.info}
        data-testid={`opt-${o.key}`}
        class="relative inline-grid place-items-center w-8 h-8 rounded-md hover:bg-surface-2 aria-pressed:bg-surface-2 cursor-pointer" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class={TONE[o.state]} aria-hidden="true">
          <Fragment set:html={ICON[o.key] ?? fallback(o.label)} />
          {o.state === "no" ? <path d="M3 21 21 3" stroke-width="2" /> : null}
        </svg>
        <span aria-hidden="true" class={`absolute right-0 bottom-0.5 grid place-items-center w-3 h-3 rounded-full text-[8px] font-bold leading-none ${BADGE[o.state]}`}>{SYM[o.state]}</span>
      </button>
    ))}
  </div>
  <p data-kopt-info role="status" class="hidden text-xs text-muted break-words"></p>
</div>

<script>
  document.addEventListener("click", (e) => {
    const b = (e.target as Element | null)?.closest<HTMLButtonElement>("button[data-kopt]");
    if (!b) return;
    e.preventDefault();
    e.stopPropagation();
    const box = b.closest(".kopts");
    const info = box?.querySelector<HTMLElement>("[data-kopt-info]");
    if (!box || !info) return;
    const on = b.getAttribute("aria-pressed") !== "true";
    box.querySelectorAll("button[data-kopt]").forEach((x) => x.setAttribute("aria-pressed", "false"));
    b.setAttribute("aria-pressed", String(on));
    info.textContent = on ? b.dataset.info ?? "" : "";
    info.classList.toggle("hidden", !on);
  });
</script>
