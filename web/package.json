{
  "name": "carhunt-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../cardb/api/openapi.yaml -o src/lib/cardb-schema.ts"
  },
  "dependencies": {
    "@astrojs/node": "9.5.5",
    "@astrojs/react": "4.4.2",
    "@tailwindcss/vite": "4.2.4",
    "astro": "5.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
